# انسخي هذا الملف باسم .env واملي القيم
DATABASE_URL=sqlite:///./artisan.db
SECRET_KEY=change-this-to-a-random-secret-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=./uploads

# المساعد الذكي لطلب الخدمة (اختياري)
# بدون مفتاح: المساعد يشتغل بالمحلل المحلي (كلمات مفتاحية، بدون إنترنت).
# مع مفتاح: يستخدم Gemini/Claude، وإذا فشل الاتصال يرجع للمحلل المحلي تلقائياً.
# مفتاح مجاني من https://aistudio.google.com/apikey (بدون بطاقة)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash-lite
# للتبديل لـ Claude: AI_PROVIDER=anthropic و AI_MODEL=claude-haiku-4-5-20251001
# AI_TIMEOUT_SECONDS=20
# AI_OFFLINE_FALLBACK=true   # false = بدون مفتاح يرجّع "غير مفعّل" بدل المحلل المحلي
